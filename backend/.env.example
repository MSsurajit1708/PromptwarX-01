# ===================================================
# ProjectMentor AI - Flask REST API Backend Environment Variables
# ===================================================

# Flask Environment Mode: development | testing | production
FLASK_ENV=development

# Application Server Port
PORT=5001

# Flask Security Secret Key
SECRET_KEY=super-secret-key-change-in-production

# JWT Authentication Secret Key
JWT_SECRET_KEY=super-jwt-secret-key-change-in-production

# JWT Token Expiration Time (in seconds, e.g. 86400 = 24 hours)
ACCESS_TOKEN_EXPIRES=86400

# JWT Refresh Token Expiration Time (in seconds, e.g. 604800 = 7 days)
REFRESH_TOKEN_EXPIRES=604800

# Database Connection URL (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL=sqlite:///projectmentor.db
# DATABASE_URL=postgresql://user:password@localhost:5432/projectmentor

# AI Service API Key (Google Gemini API Key)
AI_API_KEY=your_gemini_api_key_here

# AI Model Name
AI_MODEL=gemini-1.5-flash

# CORS Allowed Origins (* for development, or frontend URL for production)
CORS_ORIGINS=*

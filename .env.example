# ===================================================
# ProjectMentor AI - Root / Frontend Environment Variables
# ===================================================

# Next.js Public Backend API URL (Point to your Flask backend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/api/v1

# Node Environment Mode
NODE_ENV=development

# PostgreSQL Database Connection String (for Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectmentor

# AI API Key (Google Gemini API Key)
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
